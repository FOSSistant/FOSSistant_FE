{
  "manifest_version": 3,
  "name": "FOSSistant",
  "version": "1.0.0",
  "description": "FOSSistant",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "activeTab",
    "scripting",
    "webNavigation",
    "identity"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "사이드 패널 열기",
    "default_icon": {
      "16": "icons/github16.png",
      "32": "icons/github32.png",
      "48": "icons/github48.png",
      "128": "icons/github128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID",
    "scopes": ["read:user", "repo"]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
} 